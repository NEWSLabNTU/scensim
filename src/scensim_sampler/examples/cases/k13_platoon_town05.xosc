<?xml version="1.0" encoding="UTF-8"?>
<!-- 092 K13 step v's platoon (docs/roadmap/092, "K13 step v's plan"), a batch case: seats refuse it (issue 175: the model car
     starts at 22 m/s, an Init speed the batch alone takes). On base Town05's anchor west_avenue (372.518 m, 88.5 km/h; maps
     dataset v2026.11g). The ego (s 18.73) follows the model car M (s 68.43, scensim.behaviour:idm_follower, set
     zhang2024_highd_car with T, a and b drawn) at 45 m (aeb_ttc cruises above 33 m; 092 K13 step v amendment); M follows the scripted lead L, which starts at M's exact IDM
     equilibrium gap (lead_s, derived by the search's model from T), all at 22 m/s, and brakes to rest at `decel` from `onset`
     s. Every start s lies in west_avenue's stretch-free span [96.49, 151.44] m or below it (issue 166). The model alone moves
     M after its start. Values invented; a search case, not a tuned scenario. -->
<OpenSCENARIO>
  <FileHeader revMajor="1" revMinor="3" date="2026-11-25T00:00:00" author="scensim"
              description="a lead brakes; the model car between it and the ego follows it under IDM, on Town05">
    <Properties>
      <Property name="scensim.anchor.ego_lane" value="west_avenue.lanelet_at(18.73)"/>
      <Property name="scensim.anchor.ego_s" value="west_avenue.local_s(18.73)"/>
      <Property name="scensim.anchor.m_lane" value="west_avenue.lanelet_at(68.43)"/>
      <Property name="scensim.anchor.m_s" value="west_avenue.local_s(68.43)"/>
      <Property name="scensim.anchor.lead_lane" value="west_avenue.lanelet_at(param:lead_s)"/>
      <Property name="scensim.anchor.lead_ls" value="west_avenue.local_s(param:lead_s)"/>
      <Property name="scensim.anchor.goal_lane" value="west_avenue.lanelet_at(365)"/>
      <Property name="scensim.anchor.goal_s" value="west_avenue.local_s(365)"/>
    </Properties>
  </FileHeader>
  <ParameterDeclarations>
    <ParameterDeclaration name="ego_speed" parameterType="double" value="22"/>
    <ParameterDeclaration name="speed" parameterType="double" value="22"/>
    <ParameterDeclaration name="decel" parameterType="double" value="4"/>
    <ParameterDeclaration name="onset" parameterType="double" value="2"/>
    <ParameterDeclaration name="time_gap" parameterType="double" value="1.133"/>
    <ParameterDeclaration name="accel" parameterType="double" value="0.362"/>
    <ParameterDeclaration name="comfort_decel" parameterType="double" value="2.14"/>
    <ParameterDeclaration name="lead_s" parameterType="double" value="119.485"/>
    <ParameterDeclaration name="ego_lane" parameterType="string" value=""/>
    <ParameterDeclaration name="ego_s" parameterType="double" value="0"/>
    <ParameterDeclaration name="m_lane" parameterType="string" value=""/>
    <ParameterDeclaration name="m_s" parameterType="double" value="0"/>
    <ParameterDeclaration name="lead_lane" parameterType="string" value=""/>
    <ParameterDeclaration name="lead_ls" parameterType="double" value="0"/>
    <ParameterDeclaration name="goal_lane" parameterType="string" value=""/>
    <ParameterDeclaration name="goal_s" parameterType="double" value="0"/>
  </ParameterDeclarations>
  <CatalogLocations/>
  <RoadNetwork><LogicFile filepath="$(env SCENSIM_MAPS)/Town05"/></RoadNetwork>
  <Entities>
    <ScenarioObject name="ego">
      <Vehicle name="car" vehicleCategory="car"><BoundingBox><Center x="1.4" y="0" z="0.8"/><Dimensions length="4.7" width="1.9" height="1.5"/></BoundingBox><Properties/></Vehicle>
      <ObjectController><Controller name="ego"><Properties>
        <Property name="isEgo" value="true"/></Properties></Controller></ObjectController>
    </ScenarioObject>
    <ScenarioObject name="follower">
      <Vehicle name="car" vehicleCategory="car"><BoundingBox><Center x="1.4" y="0" z="0.8"/><Dimensions length="4.7" width="1.9" height="1.5"/></BoundingBox><Properties/></Vehicle>
      <ObjectController><Controller name="model"><Properties>
        <Property name="model" value="scensim.behaviour:idm_follower"/>
        <Property name="lane" value="west_avenue"/>
        <Property name="leader" value="lead"/>
        <Property name="T" value="$time_gap"/>
        <Property name="a" value="$accel"/>
        <Property name="b" value="$comfort_decel"/>
        <Property name="length" value="4.7"/>
        <Property name="center_x" value="1.4"/>
        <Property name="leader_length" value="4.7"/>
        <Property name="leader_center_x" value="1.4"/>
      </Properties></Controller></ObjectController>
    </ScenarioObject>
    <ScenarioObject name="lead">
      <Vehicle name="car" vehicleCategory="car"><BoundingBox><Center x="1.4" y="0" z="0.8"/><Dimensions length="4.7" width="1.9" height="1.5"/></BoundingBox><Properties/></Vehicle>
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init><Actions>
      <Private entityRef="ego"><PrivateAction><TeleportAction><Position>
        <LanePosition roadId="" laneId="$ego_lane" s="$ego_s" offset="0"/></Position></TeleportAction></PrivateAction>
        <PrivateAction><LongitudinalAction><SpeedAction>
          <SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time"/>
          <SpeedActionTarget><AbsoluteTargetSpeed value="$ego_speed"/></SpeedActionTarget>
        </SpeedAction></LongitudinalAction></PrivateAction>
        <PrivateAction><RoutingAction><AcquirePositionAction><Position>
          <LanePosition roadId="" laneId="$goal_lane" s="$goal_s" offset="0"/></Position></AcquirePositionAction></RoutingAction></PrivateAction></Private>
      <Private entityRef="follower"><PrivateAction><TeleportAction><Position>
        <LanePosition roadId="" laneId="$m_lane" s="$m_s" offset="0"/></Position></TeleportAction></PrivateAction>
        <PrivateAction><LongitudinalAction><SpeedAction>
          <SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time"/>
          <SpeedActionTarget><AbsoluteTargetSpeed value="$speed"/></SpeedActionTarget>
        </SpeedAction></LongitudinalAction></PrivateAction></Private>
      <Private entityRef="lead"><PrivateAction><TeleportAction><Position>
        <LanePosition roadId="" laneId="$lead_lane" s="$lead_ls" offset="0"/></Position></TeleportAction></PrivateAction>
        <PrivateAction><LongitudinalAction><SpeedAction>
          <SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time"/>
          <SpeedActionTarget><AbsoluteTargetSpeed value="$speed"/></SpeedActionTarget>
        </SpeedAction></LongitudinalAction></PrivateAction></Private>
    </Actions></Init>
    <Story name="main"><Act name="act">
      <ManeuverGroup name="brake" maximumExecutionCount="1">
        <Actors selectTriggeringEntities="false"><EntityRef entityRef="lead"/></Actors>
        <Maneuver name="brake"><Event name="brake" priority="override" maximumExecutionCount="1">
          <Action name="brake"><PrivateAction><LongitudinalAction><SpeedAction>
            <SpeedActionDynamics dynamicsShape="linear" value="$decel" dynamicsDimension="rate"/>
            <SpeedActionTarget><AbsoluteTargetSpeed value="0"/></SpeedActionTarget>
          </SpeedAction></LongitudinalAction></PrivateAction></Action>
          <StartTrigger><ConditionGroup><Condition name="brake" delay="0" conditionEdge="none">
            <ByValueCondition><SimulationTimeCondition value="$onset" rule="greaterThan"/></ByValueCondition>
          </Condition></ConditionGroup></StartTrigger>
        </Event></Maneuver>
      </ManeuverGroup>
      <StartTrigger><ConditionGroup><Condition name="t0" delay="0" conditionEdge="none">
        <ByValueCondition><SimulationTimeCondition value="0" rule="greaterThan"/></ByValueCondition>
      </Condition></ConditionGroup></StartTrigger>
    </Act></Story>
    <StopTrigger><ConditionGroup><Condition name="end" delay="0" conditionEdge="none">
      <ByValueCondition><SimulationTimeCondition value="30" rule="greaterThan"/></ByValueCondition>
    </Condition></ConditionGroup></StopTrigger>
  </Storyboard>
</OpenSCENARIO>
