<?xml version="1.0"?>
<OpenSCENARIO>
	<FileHeader author="scensim" date="2026-11-24T00:00:00+00:00" description="CS3 with its barriers as a prop layout (092 K9f-b): knob works = closed adds layout west_street_closed to the run's copy; the pilot's map is Town01 (current, stale) or the updated variant (works)" revMajor="1" revMinor="2">
		<Properties>
			<Property name="scensim.pilot_map" value="param:pm"/>
			<Property name="scensim.knob.illumination" value="param:light"/>
			<Property name="scensim.knob.works" value="param:closure"/>
		</Properties>
	</FileHeader>
	<ParameterDeclarations>
		<ParameterDeclaration name="pm" parameterType="string" value="current"/>
		<ParameterDeclaration name="light" parameterType="string" value="day"/>
		<ParameterDeclaration name="closure" parameterType="string" value="closed"/>
	</ParameterDeclarations>
	<CatalogLocations><VehicleCatalog><Directory path="$(env SCENSIM_VEHICLES)" /></VehicleCatalog></CatalogLocations>
	<RoadNetwork>
		<LogicFile filepath="$(env SCENSIM_MAPS)/Town01" />
	</RoadNetwork>
	<Entities>
		<ScenarioObject name="ego">
			<CatalogReference catalogName="vehicles" entryName="tesla_model3">
				<ParameterAssignments>
					<ParameterAssignment parameterRef="maxSpeed" value="50" />
					<ParameterAssignment parameterRef="maxAcceleration" value="15.0" />
					<ParameterAssignment parameterRef="maxDeceleration" value="15.0" />
					<ParameterAssignment parameterRef="maxSteering" value="0.5" />
				</ParameterAssignments>
			</CatalogReference>
			<ObjectController>
				<Controller name="Autoware">
					<Properties>
						<Property name="maxJerk" value="1.5" />
						<Property name="minJerk" value="-1.5" />
					</Properties>
				</Controller>
			</ObjectController>
		</ScenarioObject>
	</Entities>
	<Storyboard>
		<Init>
			<Actions>
				<Private entityRef="ego">
					<PrivateAction><TeleportAction><Position><WorldPosition x="334.852" y="-79.029" z="0.3" h="-1.5708" p="0" r="0" /></Position></TeleportAction></PrivateAction>
					<PrivateAction><RoutingAction><AcquirePositionAction><Position><WorldPosition x="92.382" y="-78.140" z="0.0" h="1.5708" p="0" r="0" /></Position></AcquirePositionAction></RoutingAction></PrivateAction>
				</Private>
			</Actions>
		</Init>
		<Story name="cs3">
			<Act name="drive">
				<ManeuverGroup maximumExecutionCount="1" name="ego_maneuvers">
					<Actors selectTriggeringEntities="false"><EntityRef entityRef="ego" /></Actors>
					<Maneuver name="end_conditions">
						<Event name="success" priority="parallel">
							<Action name="exit_success"><UserDefinedAction><CustomCommandAction type="exitSuccess" /></UserDefinedAction></Action>
							<StartTrigger><ConditionGroup><Condition name="reach_goal" delay="0" conditionEdge="none">
								<ByEntityCondition><TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="ego" /></TriggeringEntities>
									<EntityCondition><ReachPositionCondition tolerance="5.0"><Position><WorldPosition x="92.382" y="-78.140" z="0.0" h="0" p="0" r="0" /></Position></ReachPositionCondition></EntityCondition>
								</ByEntityCondition>
							</Condition></ConditionGroup></StartTrigger>
						</Event>
						<Event name="timeout" priority="parallel">
							<Action name="exit_failure"><UserDefinedAction><CustomCommandAction type="exitFailure" /></UserDefinedAction></Action>
							<StartTrigger><ConditionGroup><Condition name="limit" delay="0" conditionEdge="none">
								<ByValueCondition><SimulationTimeCondition value="240" rule="greaterThan" /></ByValueCondition>
							</Condition></ConditionGroup></StartTrigger>
						</Event>
					</Maneuver>
				</ManeuverGroup>
				<StartTrigger><ConditionGroup><Condition name="start" delay="0" conditionEdge="none">
					<ByValueCondition><SimulationTimeCondition value="0" rule="greaterThan" /></ByValueCondition>
				</Condition></ConditionGroup></StartTrigger>
			</Act>
		</Story>
		<StopTrigger />
	</Storyboard>
</OpenSCENARIO>
