<?xml version="1.0"?>
<!--
	094 P4: the lead car brakes ahead, CS2's family (docs/design/scenario-description.md) made
	stock's task (WheeledLab isaaclab-3.0 bench/p4_leadbrake, fef6385): one straight lane on a dry
	road by day, the ego at the lead's speed behind it, the lead braking at a constant rate to a
	stop once its rear is at or past the onset (a state: a lead that starts past it brakes at once). The episode is drawn per reset (leadbrake_dist.xosc);
	the road is the task's world (scensim_batch.tasks.leadbrake: a straight 400 m lanelet, 3.5 m
	wide, lanelet 1). 30 s, stock's time-out: a time-up the task reads as a truncation.
	Both cars are the Tesla Model 3 (sim_vehicle_spec's catalog entry; its box is stock's lead's).
-->
<OpenSCENARIO>
	<FileHeader author="scensim" date="2026-11-22T00:00:00+00:00" description="the lead car brakes ahead, straight, dry, day (094 P4)" revMajor="1" revMinor="2">
		<Properties><Property name="scensim.category" value="R1.lead_brake.straight_dry_day" /></Properties>
	</FileHeader>
	<ParameterDeclarations>
		<ParameterDeclaration name="ego_speed" parameterType="double" value="10.0" />
		<ParameterDeclaration name="lead_speed" parameterType="double" value="10.0" />
		<ParameterDeclaration name="lead_s" parameterType="double" value="29.792" />
		<ParameterDeclaration name="decel" parameterType="double" value="5.0" />
		<ParameterDeclaration name="onset_d" parameterType="double" value="1085.98" />
	</ParameterDeclarations>
	<CatalogLocations><VehicleCatalog><Directory path="$(env SCENSIM_VEHICLES)" /></VehicleCatalog></CatalogLocations>
	<RoadNetwork><LogicFile filepath="straight400" /></RoadNetwork>
	<Entities>
		<ScenarioObject name="ego">
			<CatalogReference catalogName="vehicles" entryName="tesla_model3" />
			<ObjectController><Controller name="Autoware"><Properties><Property name="maxJerk" value="10.0" /></Properties></Controller></ObjectController>
		</ScenarioObject>
		<ScenarioObject name="lead">
			<CatalogReference catalogName="vehicles" entryName="tesla_model3" />
		</ScenarioObject>
	</Entities>
	<Storyboard>
		<Init><Actions>
			<Private entityRef="ego">
				<PrivateAction><TeleportAction><Position><LanePosition roadId="" laneId="1" s="5.0" offset="0" /></Position></TeleportAction></PrivateAction>
				<PrivateAction><LongitudinalAction><SpeedAction>
					<SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time" />
					<SpeedActionTarget><AbsoluteTargetSpeed value="$ego_speed" /></SpeedActionTarget>
				</SpeedAction></LongitudinalAction></PrivateAction>
			</Private>
			<Private entityRef="lead">
				<PrivateAction><TeleportAction><Position><LanePosition roadId="" laneId="1" s="$lead_s" offset="0" /></Position></TeleportAction></PrivateAction>
				<PrivateAction><LongitudinalAction><SpeedAction>
					<SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time" />
					<SpeedActionTarget><AbsoluteTargetSpeed value="$lead_speed" /></SpeedActionTarget>
				</SpeedAction></LongitudinalAction></PrivateAction>
			</Private>
		</Actions></Init>
		<Story name="lead_brake"><Act name="act">
			<ManeuverGroup name="brake" maximumExecutionCount="1">
				<Actors selectTriggeringEntities="false"><EntityRef entityRef="lead" /></Actors>
				<Maneuver name="brake"><Event name="brake" priority="override" maximumExecutionCount="1">
					<Action name="brake"><PrivateAction><LongitudinalAction><SpeedAction>
						<SpeedActionDynamics dynamicsShape="linear" value="-$decel" dynamicsDimension="rate" />
						<SpeedActionTarget><AbsoluteTargetSpeed value="0" /></SpeedActionTarget>
					</SpeedAction></LongitudinalAction></PrivateAction></Action>
					<!-- a state, as stock's `lead_s >= onset`, not a crossing: the lead's distance from a
					     point 1000 m behind the lane's start, which on this straight lane, the lead on its
					     centre line, is its s + 1000; so a lead that starts past the onset brakes at once
					     (243). SSv2 runs it (a euclidean DistanceCondition to a WorldPosition) -->
					<StartTrigger><ConditionGroup><Condition name="onset" delay="0" conditionEdge="none">
						<ByEntityCondition><TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="lead" /></TriggeringEntities>
							<EntityCondition><DistanceCondition value="$onset_d" freespace="false" rule="greaterOrEqual"
									relativeDistanceType="euclidianDistance" coordinateSystem="entity"><Position>
								<WorldPosition x="-1000.0" y="0.0" z="0.0" h="0" p="0" r="0" />
							</Position></DistanceCondition></EntityCondition>
						</ByEntityCondition>
					</Condition></ConditionGroup></StartTrigger>
				</Event></Maneuver>
			</ManeuverGroup>
			<StartTrigger><ConditionGroup><Condition name="t0" delay="0" conditionEdge="none">
				<ByValueCondition><SimulationTimeCondition value="0" rule="greaterThan" /></ByValueCondition>
			</Condition></ConditionGroup></StartTrigger>
		</Act></Story>
		<StopTrigger><ConditionGroup><Condition name="time_out" delay="0" conditionEdge="none">
			<ByValueCondition><SimulationTimeCondition value="30" rule="greaterThan" /></ByValueCondition>
		</Condition></ConditionGroup></StopTrigger>
	</Storyboard>
</OpenSCENARIO>
