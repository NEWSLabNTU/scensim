<?xml version="1.0" encoding="UTF-8"?>
<!-- K11d's scenario (docs/roadmap/092, "K11d's spec"): K11c's cs1_town01_k11c.xosc with the walker's decision draw declared as
     the parameter accept_u and bound to its model's `draw`, so the search can move it. Everything else is K11c's file's. Its
     base is scensim_sampler's examples/cases/models/cs1_gap_acceptance_k11d.yaml, invented. -->
<OpenSCENARIO>
  <FileHeader revMajor="1" revMinor="3" date="2026-11-22T00:00:00" author="scensim"
              description="a walker behind a parked van takes or rejects the ego's gap, on Town01; one cell, for K11d">
    <Properties>
      <!-- Town01's street west from (325.6, -129.5), 224 m, one lanelet (maps dataset v2026.11e) -->
      <Property name="scensim.anchor.street" value="west_street.lanelet_at(0)"/>
      <Property name="scensim.category" value="R2.walker_crossing.dart_out"/>
      <Property name="scensim.cell_attributes" value="illumination,surface,occluder"/>
      <Property name="scensim.cell.illumination" value="day"/>
      <Property name="scensim.cell.surface" value="dry"/>
      <Property name="scensim.cell.occluder" value="van"/>
    </Properties>
  </FileHeader>
  <ParameterDeclarations>
    <ParameterDeclaration name="ego_speed" parameterType="double" value="8.3"/>
    <ParameterDeclaration name="walk_speed" parameterType="double" value="1.4"/>
    <ParameterDeclaration name="ttc_entry" parameterType="double" value="3.0"/>
    <ParameterDeclaration name="behaviour" parameterType="string" value="steady"/>
    <ParameterDeclaration name="accept_u" parameterType="double" value="0.5"/>
    <ParameterDeclaration name="street" parameterType="string" value=""/>
  </ParameterDeclarations>
  <CatalogLocations><VehicleCatalog><Directory path="$(env SCENSIM_VEHICLES)"/></VehicleCatalog></CatalogLocations>
  <RoadNetwork><LogicFile filepath="$(env SCENSIM_MAPS)/Town01"/></RoadNetwork>
  <Entities>
    <ScenarioObject name="ego">
      <CatalogReference catalogName="vehicles" entryName="tesla_model3"><ParameterAssignments>
        <ParameterAssignment parameterRef="maxSpeed" value="50"/>
        <ParameterAssignment parameterRef="maxAcceleration" value="15.0"/>
        <ParameterAssignment parameterRef="maxDeceleration" value="15.0"/>
        <ParameterAssignment parameterRef="maxSteering" value="0.5"/>
      </ParameterAssignments></CatalogReference>
      <ObjectController><Controller name="ego"><Properties>
        <Property name="isEgo" value="true"/></Properties></Controller></ObjectController>
    </ScenarioObject>
    <ScenarioObject name="van">
      <MiscObject name="van" miscObjectCategory="obstacle" mass="2000"><BoundingBox><Center x="0" y="0" z="1.1"/><Dimensions length="5.2" width="2.0" height="2.2"/></BoundingBox><Properties/></MiscObject>
    </ScenarioObject>
    <ScenarioObject name="walker">
      <Pedestrian model="unspecified" mass="60" name="walker.pedestrian.0001" pedestrianCategory="pedestrian"><BoundingBox><Center x="0" y="0" z="0.9"/><Dimensions length="0.4" width="0.5" height="1.8"/></BoundingBox><Properties/></Pedestrian>
      <ObjectController><Controller name="model"><Properties>
        <Property name="model" value="scensim.behaviour:gap_acceptance_walker"/>
        <Property name="speed" value="$walk_speed"/>
        <Property name="style" value="$behaviour"/>
        <Property name="start_gap" value="$ttc_entry"/>
        <Property name="approach" value="1.5"/>
        <Property name="draw" value="$accept_u"/>
        <Property name="anchor.crossing" value="7.0"/>
      </Properties></Controller></ObjectController>
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init><Actions>
      <Private entityRef="ego"><PrivateAction><TeleportAction><Position>
        <LanePosition roadId="" laneId="$street" s="5" offset="0"/></Position></TeleportAction></PrivateAction>
        <PrivateAction><LongitudinalAction><SpeedAction>
          <SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time"/>
          <SpeedActionTarget><AbsoluteTargetSpeed value="$ego_speed"/></SpeedActionTarget>
        </SpeedAction></LongitudinalAction></PrivateAction>
        <PrivateAction><RoutingAction><AcquirePositionAction><Position>
          <LanePosition roadId="" laneId="$street" s="210" offset="0"/></Position></AcquirePositionAction></RoutingAction></PrivateAction></Private>
      <Private entityRef="van"><PrivateAction><TeleportAction><Position>
        <LanePosition roadId="" laneId="$street" s="44" offset="-2.6"/></Position></TeleportAction></PrivateAction></Private>
      <Private entityRef="walker"><PrivateAction><TeleportAction><Position>
        <LanePosition roadId="" laneId="$street" s="47" offset="-3.25">
          <Orientation type="relative" h="1.5707963267948966"/></LanePosition>
      </Position></TeleportAction></PrivateAction></Private>
    </Actions></Init>
    <Story name="main"><Act name="act">
      <ManeuverGroup name="kerb" maximumExecutionCount="1">
        <Actors selectTriggeringEntities="false"/>
        <!-- the walker at its far kerb (1.5 m approach and the 7 m crossing from its Init offset) ends the run -->
        <Maneuver name="kerb"><Event name="walker_far_kerb" priority="parallel">
          <Action name="mark"><UserDefinedAction><CustomCommandAction type="exitSuccess"/></UserDefinedAction></Action>
          <StartTrigger><ConditionGroup><Condition name="far_kerb" delay="0" conditionEdge="rising">
            <ByEntityCondition><TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="walker"/></TriggeringEntities>
              <EntityCondition><ReachPositionCondition tolerance="1.0"><Position>
                <LanePosition roadId="" laneId="$street" s="47" offset="5.25"/></Position></ReachPositionCondition></EntityCondition>
            </ByEntityCondition>
          </Condition></ConditionGroup></StartTrigger>
        </Event></Maneuver>
      </ManeuverGroup>
      <StartTrigger><ConditionGroup><Condition name="t0" delay="0" conditionEdge="none">
        <ByValueCondition><SimulationTimeCondition value="0" rule="greaterThan"/></ByValueCondition>
      </Condition></ConditionGroup></StartTrigger>
    </Act></Story>
    <StopTrigger><ConditionGroup><Condition name="end" delay="0" conditionEdge="none">
      <ByValueCondition><SimulationTimeCondition value="20" rule="greaterThan"/></ByValueCondition>
    </Condition></ConditionGroup></StopTrigger>
  </Storyboard>
</OpenSCENARIO>
