#!/usr/bin/env python3
"""The pre-push hook (`just setup` installs it; `just install-hooks` alone): a push that would
move `main` is refused unless scripts/check_pins.py passes on the commit it pushes, whatever
the commit holds, a docs-only edit included. Twice in a day a `git commit -a` in a worktree
with stale submodule checkouts reverted component pins, once on main (ab7c7b82, fixed by
494064bb), and nothing ran the check on a direct push.

git runs it as `pre-push <remote> <url>` with one line per ref on stdin:
`<local ref> <local sha> <remote ref> <remote sha>`.
"""
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent   # scripts/ of the checkout the hook links to
GUARDED = ("refs/heads/main",)
ZERO = "0" * 40


def targets(lines):
    """The local commits pushed to a guarded ref (a deletion has none)."""
    out = []
    for line in lines:
        parts = line.split()
        if len(parts) != 4:
            continue
        _, local_sha, remote_ref, _ = parts
        if remote_ref in GUARDED and local_sha != ZERO:
            out.append((remote_ref, local_sha))
    return out


def run(lines, check):
    """0 when every guarded push passes `check(sha) -> (checked, [mismatches])`, else 1,
    the mismatches printed."""
    status = 0
    for ref, sha in targets(lines):
        checked, bad = check(sha)
        if bad:
            status = 1
            print(f"pre-push: refusing to push {sha[:10]} to {ref}: its pins do not match "
                  f"({len(bad)} mismatch(es), {checked} checked):", file=sys.stderr)
            for line in bad:
                print(f"  {line}", file=sys.stderr)
            print("  a commit made with `git commit -a` in a checkout whose submodules lag its "
                  "pins does this: commit by path, and see `git show --stat`", file=sys.stderr)
    return status


def main():
    # the worktree pushing (git runs the hook at its top), whose submodule checkouts hold the
    # components' commits; the hook itself is shared by every worktree of the repository
    root = Path(subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True,
                               text=True, check=True).stdout.strip())
    check = None
    # the pushing checkout's check, else (one from before `check`) the linked checkout's
    for d in (root / "scripts", HERE):
        f = d / "check_pins.py"
        if f.is_file():
            import importlib.util
            spec = importlib.util.spec_from_file_location(f"check_pins_{len(str(d))}", f)
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            if hasattr(mod, "check"):
                check = mod.check
                break
    if check is None:
        print("pre-push: no scripts/check_pins.py with check(): cannot check the pins",
              file=sys.stderr)
        return 1
    return run(sys.stdin.read().splitlines(), lambda sha: check(sha, root))


if __name__ == "__main__":
    sys.exit(main())
